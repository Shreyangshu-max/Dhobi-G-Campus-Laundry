/* ============================================================
   SERVICES.CSS — "WHAT WE DO" accordion section
   Dhobi G Campus Laundry
   ============================================================ */

.services-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 8rem 2.5rem;
}

/* ── Section header ── */
.svc-header {
    position: relative;
    padding-bottom: 3.5rem;
}

.svc-header-tag {
    position: absolute;
    top: 0.6rem;
    right: 0;
    font-family: var(--font-body);
    font-size: 0.8rem;
    letter-spacing: 1.5px;
    color: var(--muted);
}

.svc-header-title {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 7.5vw, 6.5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -2px;
    text-transform: uppercase;
    color: var(--white);
}

.svc-header-title .accent { color: var(--blue); }

/* ── Divider ── */
.svc-divider {
    width: 100%;
    height: 1px;
    background: var(--border);
}

/* ── Service item ── */
.service-item {
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    overflow: hidden;
    transition: background 0.3s ease;
}

.service-item:hover { background: rgba(255, 255, 255, 0.012); }

/* Main row — always visible */
.svc-row {
    display: flex;
    align-items: flex-start;
    padding: 1.6rem 0;
    min-height: 82px;
}

/* ── Number ── */
.svc-num {
    width: 140px;
    flex-shrink: 0;
    font-family: var(--font-heading);
    font-size: 1.65rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.18);
    padding-top: 0.15rem;
    user-select: none;
    transition: color 0.35s ease;
}

.svc-num .dot { color: var(--blue); }

.service-item.active .svc-num { color: rgba(255, 255, 255, 0.32); }

/* ── Image slot ── */
.svc-img-wrap {
    flex-shrink: 0;
    width: 0;
    height: 0;
    overflow: hidden;
    opacity: 0;
    border-radius: 6px;
    background: rgba(0, 123, 181, 0.07);
    border: 1px solid rgba(0, 123, 181, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
        width       0.65s var(--ease-out),
        height      0.65s var(--ease-out),
        opacity     0.45s ease,
        margin-right 0.65s var(--ease-out);
    margin-right: 0;
}

.service-item.active .svc-img-wrap {
    width: 310px;
    height: 290px;
    opacity: 1;
    margin-right: 3rem;
}

.svc-img-wrap .slot-icon {
    width: 100px;
    height: 100px;
    color: var(--blue);
    opacity: 0.5;
    transition: opacity 0.4s ease;
}

.service-item.active .svc-img-wrap .slot-icon { opacity: 0.65; }

/* ── Details column ── */
.svc-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;   /* right-align when collapsed */
    padding-top: 0.15rem;
}

.service-item.active .svc-details { align-items: flex-start; }

/* Name label — always visible */
.svc-name-label {
    font-family: var(--font-heading);
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.48);
    line-height: 1.25;
    transition:
        font-size   0.45s var(--ease-out),
        color       0.35s ease;
}

.service-item.active .svc-name-label {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.3);
    margin-bottom: 0.55rem;
    letter-spacing: 0.3px;
}

/* ── Expanded block ── */
.svc-expanded {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
        max-height  0.65s var(--ease-out),
        opacity     0.45s ease;
}

.service-item.active .svc-expanded {
    max-height: 500px;
    opacity: 1;
}

.svc-name-big {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.8vw, 2.4rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--white);
    margin-bottom: 0.8rem;
}

.svc-desc {
    font-size: 0.92rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.42);
    max-width: 440px;
    margin-bottom: 2rem;
}

/* ── Tags ── */
.svc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding-bottom: 2.5rem;
}

.svc-tag {
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 100px;
    padding: 0.32rem 0.85rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.42);
    letter-spacing: 0.3px;
    transition: border-color 0.25s ease, color 0.25s ease;
}

.svc-tag:hover {
    border-color: var(--blue);
    color: var(--blue);
}

/* ── Responsive ── */
@media (max-width: 860px) {
    .svc-num { width: 80px; font-size: 1.3rem; }
    .service-item.active .svc-img-wrap { width: 220px; height: 210px; margin-right: 1.5rem; }
}

@media (max-width: 600px) {
    .svc-row { flex-wrap: wrap; gap: 1rem; min-height: auto; }
    .svc-num { width: 60px; font-size: 1.1rem; }
    .service-item.active .svc-img-wrap { width: 100%; height: 220px; margin-right: 0; }
    .svc-details { align-items: flex-start; width: 100%; }
}
